# MongoDB (required for production)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/d1-nation

# Auth — use a long random string (32+ characters)
AUTH_SECRET=replace-with-a-secure-random-string-at-least-32-chars

# Initial admin (used by `npm run seed` only — change password after first login)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# Public site URL (SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudinary (required for admin media uploads on Vercel)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: email notifications for new inquiries (not wired by default)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# INQUIRY_NOTIFY_TO=RealD1Nation@gmail.com
